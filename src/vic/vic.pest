WHITESPACE = _{ " " | "\t" | NEWLINE }
COMMENT    = _{ !"\\" ~ "#" ~ (!NEWLINE ~ ANY)+ ~ NEWLINE? }

// Prelude options

backup_ext               = { "backup_ext" ~ "=" ~ expr }
template                 = { "template" ~ "=" ~ expr }
delimiter                = { "delimiter" ~ "=" ~ expr }
file                     = { "file" ~ "=" ~ expr }
files                    = { "files" ~ "=" ~ expr }
pipe_in                  = { "pipe_in" ~ "=" ~ expr }
pipe_out                 = { "pipe_out" ~ "=" ~ expr }
write                    = { "write" ~ "=" ~ expr }
max_jobs                 = { "max_jobs" ~ "=" ~ expr }
trace                    = { "trace" }
json                     = { "json" }
linewise                 = { "linewise" }
serial                   = { "serial" }
trim_fields              = { "trim_fields" }
keep_mode                = { "keep_mode" }
backup                   = { "backup" }
edit_inplace             = { "edit_inplace" }
silent                   = { "silent" }
no_input                 = { "no_input" }
global_uses_line_numbers = { "global_uses_line_numbers" }

opt    = {
    json
  | pipe_in
  | pipe_out
  | linewise
  | serial
  | trim_fields
  | keep_mode
  | backup_ext
  | backup
  | template
  | delimiter
  | max_jobs
  | trace
  | file
  | no_input
  | silent
  | global_uses_line_numbers
  | edit_inplace
  | write
  | files
}
opts = { "opt" ~ "{" ~ (((not* ~ opt) ~ ",")* ~ (not* ~ opt)?)? ~ "}" }

// Script Commands
// Whitespace positioning needs to be enforced strictly here

global        = ${ ("global" | "g") ~ " "+ ~ expr ~ WHITESPACE* ~ block ~ WHITESPACE* }
not_global    = ${ ("v" | "not_global" | "!global") ~ " "+ ~ expr ~ WHITESPACE* ~ block ~ WHITESPACE* }
move          = ${ ("move" | "m") ~ " "+ ~ expr ~ WHITESPACE* }
cut           = ${ ("cut" | "c") ~ " "+ ~ expr ~ WHITESPACE* }
next          = ${ "next" ~ WHITESPACE+ }
repeat        = ${ ("repeat") ~ " "+ ~ expr ~ " "+ ~ block }
break_loop    = ${ ("break") ~ WHITESPACE* }
new           = ${ "new" ~ WHITESPACE+ ~ expr ~ WHITESPACE* }
continue_loop = ${ ("continue") ~ WHITESPACE* }
return        = ${ ("return" | "ret") ~ " "+ ~ expr }
include       = ${ ("include") ~ " "+ ~ expr ~ WHITESPACE* }

command = {
    global
  | not_global
  | move
  | cut
  | new
  | next
  | repeat
  | break_loop
  | continue_loop
  | return
  | include
}

// Control Flow

range           = { expr ~ ".." ~ expr }
range_inclusive = { expr ~ "..=" ~ expr }

for_block          = { "for" ~ var ~ "in" ~ (range_inclusive | range | expr) ~ block }
while_block        = { "while" ~ expr_bool_priority ~ block }
until_block        = { "until" ~ expr_bool_priority ~ block }
if_block           = { "if" ~ expr_bool_priority ~ block ~ elif_block* ~ else_block? }
elif_block         = { "elif" ~ expr_bool_priority ~ block }
else_block         = { "else" ~ block }
expr_bool_priority = { bool_expr | bool | expr }

// Expressions
// We will just allow indexes on these
// And check at run time if it's a valid spot for one
bin_expr = { bin_atom ~ (bin_op ~ bin_atom)+ }
bin_atom = { bin_lit | ("(" ~ bin_expr ~ ")") }
bin_lit  = { negative? ~ expr_not_recursive }
bin_op   = { add | sub | mult | div | modulo | pow }
add      = { "+" }
sub      = { "-" }
mult     = { "*" }
div      = { "/" }
modulo   = { "%" }
pow      = { "**" }
negative = { "-" }

bool_expr = { bool_atom ~ (bool_op ~ bool_atom)+ |  (not+ ~ bool_atom)}
bool_expr_single_ok = { not* ~ bool_atom ~ (bool_op ~ bool_atom)* }
bool_atom = { not* ~ (bool_lit | ("(" ~ bool_expr_single_ok ~ ")")) }
bool_lit  = { (expr_not_recursive | ("(" ~ bin_expr ~ ")")) }

bool_op = { eq | ne | lt | le | ge | gt | and | or }
eq      = { "==" }
ne      = { "!=" }
lt      = { "<" }
le      = { "<=" }
gt      = { ">" }
ge      = { ">=" }
and     = { "&&" }
or      = { "||" }
not     = { "!" }

// I'm not sure why I need to nest these rules like this
// but it didn't work right until I did
expr               = !{
    (bin_expr | func_call | (bool_expr | (command | value))) ~ accessor*
}
expr_not_recursive = !{
    (command | func_call | value) ~ accessor*
}

accessor = { field | index }

field = { "." ~ var }

index        = {
    "[" ~ (index_to | slice | index_from | index_sng) ~ "]"
}
index_to     = { ".." ~ expr }
slice        = { expr ~ ".." ~ expr }
index_from   = { expr ~ ".." }
index_sng    = { expr }

// Variable Operations
var         = @{ (ASCII_ALPHANUMERIC | "_")+ }
var_declare =  { "let" ~ var ~ "=" ~ expr }
var_mut     =  { var ~ accessor* ~ "=" ~ expr }
var_add     =  { var ~ accessor* ~ "+=" ~ expr }
var_sub     =  { var ~ accessor* ~ "-=" ~ expr }
var_mult    =  { var ~ accessor* ~ "*=" ~ expr }
var_div     =  { var ~ accessor* ~ "/=" ~ expr }
var_pow     =  { var ~ accessor* ~ "^=" ~ expr }
var_mod     =  { var ~ accessor* ~ "%=" ~ expr }

// Class stuff

class_def = { "class" ~ var ~ class_block }
class_block = { "{" ~ key_value_list ~ func_def* ~ "}" }

// Function stuff

var_list = { (var ~ ",")* ~ var? }

closure_def_args = { "|" ~ var_list ~ "|" }

func_def_args = { "(" ~ var_list ~ ")" }
func_name     = { var ~ func_def_args }
func_def      = { "def" ~ func_name ~ block }

func_call_args = { "(" ~ expr_list ~ ")" }
func_call      = { func_call_name ~ func_call_args ~ accessor* }
func_call_name = !{
    value ~ accessor*
}

// Primitives

str_inner     = ${ ("\\\\" | ("\\" ~ "\"") | (!"\"" ~ ANY))* }
raw_inner     =  ${ (!PEEK_ALL ~ ANY)* }
str_literal   =  ${ raw_literal | ("\"" ~ str_inner ~ "\"") }
raw_literal   =  _{ "r" ~ PUSH("-") ~ (&PEEK ~ PUSH("-"))* ~ PUSH("\"") ~ raw_inner ~ POP_ALL }
closure       =  { closure_def_args ~ block }

true  = { "true" }
false = { "false" }
bool  = { true | false }

int = @{ ASCII_DIGIT+ }

array = { "[" ~ expr_list ~ "]" }

key_value = { var ~ ":" ~ expr }
key_value_list = { ((key_value ~ ",")* ~ key_value?)? }
dict = { "{" ~ key_value_list ~ "}" }

expr_list = { ((expr ~ ",")* ~ expr?)? }

null = { "null" }

regex_delim = _{ !(ASCII_ALPHANUMERIC | "'" | "}" | "{" | "(" | ")" | "[" | "]") ~ ANY }
regex       =  { PUSH(regex_delim) ~ (&PEEK ~ PUSH(regex_delim))* ~ raw_inner ~ POP_ALL }

register = { "@" ~ reg_name }
reg_name = { ASCII_ALPHA }

value = {
    array
  | dict
  | null
  | int
  | str_literal
  | bool
  | var
  | closure
  | register
  | regex
}

top_level_cmd = {
    var_declare
  | opts
  | var_add
  | var_sub
  | var_mut
  | var_mult
  | var_div
  | var_pow
  | var_mod
  | for_block
  | if_block
  | while_block
  | until_block
  | command
  | class_def
  | func_def
  | func_call
}

block = !{ "{" ~ (top_level_cmd ~ ";"?)* ~ "}" }

vic = { SOI ~ WHITESPACE* ~ (top_level_cmd ~ ";"?)* ~ WHITESPACE* ~ EOI }
